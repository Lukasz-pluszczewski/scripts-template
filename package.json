{
  "name": "scripts",
  "private": true,
  "version": "2.1.0",
  "description": "scripts",
  "repository": "https://github.com/Lukasz-pluszczewski/scripts-template",
  "type": "module",
  "scripts": {
    "start": "nub --no-env-file runtime/run.ts",
    "start:watch": "nub --no-env-file --watch runtime/run.ts",
    "generate": "nub runtime/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format --write ./src ./runtime",
    "lint": "biome lint ./src ./runtime",
    "check": "biome lint ./src ./runtime && tsc --noEmit && vitest run"
  },
  "author": "Łukasz Pluszczewski",
  "license": "MIT",
  "dependencies": {
    "yargs-parser": "^21.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/node": "^24.19.2",
    "@types/yargs-parser": "^21.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
