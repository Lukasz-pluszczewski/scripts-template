{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["runtime/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  // Scripts that don't typecheck yet (unfinished experiments, older library APIs).
  // Remove a script from this list once it typechecks again.
  "exclude": []
}
